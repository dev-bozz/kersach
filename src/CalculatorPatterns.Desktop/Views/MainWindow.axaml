<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CalculatorPatterns.Desktop.Views.MainWindow" Title="Калькулятор — паттерны проектирования" Width="1100" Height="760" MinWidth="950" MinHeight="650" Background="#F3F5F9">
  <Grid ColumnDefinitions="2*,1*" RowDefinitions="Auto,*" Margin="22">
    <Border Grid.ColumnSpan="2" Background="#FFFFFF" CornerRadius="16" Padding="18" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,Auto,Auto"><StackPanel><TextBlock Text="КАЛЬКУЛЯТОР" FontSize="13" Foreground="#65718A"/><TextBlock Text="Проектирование с паттернами" FontSize="23" FontWeight="SemiBold" Foreground="#17233B"/></StackPanel><Border Grid.Column="1" Background="#E9EEFA" CornerRadius="10" Padding="12,8" Margin="8,0"><TextBlock Text="{Binding ModeLabel}" FontWeight="SemiBold" Foreground="#294F9D"/></Border><Border Grid.Column="2" Background="#E9EEFA" CornerRadius="10" Padding="12,8"><TextBlock Text="{Binding AngleLabel}" FontWeight="SemiBold" Foreground="#294F9D"/></Border></Grid>
    </Border>
    <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="18" Margin="0,0,14,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Text="{Binding Expression}" HorizontalAlignment="Right" Foreground="#73809A" FontSize="18" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Row="1" Text="{Binding Display}" HorizontalAlignment="Right" FontSize="52" FontWeight="Light" Foreground="#17233B" Margin="0,4,0,10" TextTrimming="CharacterEllipsis"/>
        <ItemsControl Grid.Row="2" ItemsSource="{Binding CurrentRows}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Tag="{Binding}" Click="OnButtonClick" Margin="4" MinHeight="48" FontSize="16" CornerRadius="9" Background="#F0F3F9" Foreground="#26344F" ToolTip.Tip="Выполнить команду калькулятора" AutomationProperties.Name="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Border Grid.Row="3" Background="#FFF0EE" CornerRadius="8" Padding="10" IsVisible="{Binding HasError}" Margin="4,8,4,0"><TextBlock Text="{Binding Error}" Foreground="#A72D20" TextWrapping="Wrap"/></Border>
      </Grid>
    </Border>
    <Border Grid.Column="1" Grid.Row="1" Background="White" CornerRadius="16" Padding="16">
      <Grid RowDefinitions="Auto,Auto,*"><TextBlock Text="История вычислений" FontSize="20" FontWeight="SemiBold" Foreground="#17233B"/><TextBlock Grid.Row="1" Text="Выберите запись, чтобы вернуть выражение" FontSize="12" Foreground="#7A869D" Margin="0,4,0,10"/><ListBox Grid.Row="2" ItemsSource="{Binding History}" SelectionChanged="OnHistorySelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Padding="8,10" BorderBrush="#E8ECF3" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Expression}" Foreground="#75819A" FontSize="13"/><TextBlock Text="{Binding Result}" Foreground="#26344F" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}" Foreground="#9AA4B5" FontSize="11"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
    </Border>
  </Grid>
</Window>
